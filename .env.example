# FileSanitizer Configuration
APP_NAME=FileSanitizer
APP_ENV=production
DEBUG=false
API_PREFIX=/api

# Storage & Isolated Jobs
JOBS_DIR=/jobs
MAX_FILE_SIZE_MB=100
FILE_RETENTION_MINUTES=30
CLEANUP_INTERVAL_SECONDS=300

# Archive Extraction & Safety Thresholds
MAX_ARCHIVE_FILES=10000
MAX_ARCHIVE_SIZE_MB=500
MAX_RECURSION_DEPTH=5
MAX_PROCESSING_TIME=300

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SECRET_KEY=filesanitizer-jwt-secret-key-32byte-minimum-secure-2026

# YARA Engine
YARA_ENABLED=true

# ClamAV Antivirus Daemon
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
CLAMAV_DB_DIR=/var/lib/clamav

# Pluggable URL Reputation Services (Optional)
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=

SAFE_BROWSING_ENABLED=false
SAFE_BROWSING_API_KEY=

URLHAUS_ENABLED=false
URLHAUS_API_KEY=

# Sandboxed Playwright Screenshot Service
SCREENSHOT_ENABLED=true
BROWSER_SERVICE_URL=http://browser:3000/screenshot
SCREENSHOT_TIMEOUT=15

# Redis Job Queue Broker
REDIS_URL=redis://redis:6379/0
