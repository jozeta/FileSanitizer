FROM python:3.11-slim
% Generated by malicious-pdf - https://github.com/jonaslejon/malicious-pdf

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clone repository and install Python dependencies
RUN git clone https://github.com/jonaslejon/malicious-pdf.git /app \
    && pip install --no-cache-dir -r requirements.txt

ENTRYPOINT ["python3", "malicious-pdf.py"]
CMD ["https://filesanitizer.local/callback", "--output-dir", "/output"]
